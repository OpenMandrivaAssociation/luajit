From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: huangqiqi <huangqiqi@loongson.cn>
Date: Thu, 24 Oct 2024 16:48:50 +0800
Subject: [PATCH 38/91] LOONGARCH64: Fix the way to load UREF*->op1 address in
 asm_uref function

---
 src/lj_asm_loongarch64.h | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/lj_asm_loongarch64.h b/src/lj_asm_loongarch64.h
index f54f957a..22c702a2 100644
--- a/src/lj_asm_loongarch64.h
+++ b/src/lj_asm_loongarch64.h
@@ -902,8 +902,8 @@ static void asm_uref(ASMState *as, IRIns *ir)
       emit_djs12(as, LOONGI_LD_BU, tmp, dest, offsetof(GCupval, closed));
     if (irref_isk(ir->op1)) {
       GCfunc *fn = ir_kfunc(IR(ir->op1));
-      GCobj *o = gcref(fn->l.uvptr[(ir->op2 >> 8)]);
-      emit_loada(as, dest, o); // TODO
+      uint64_t k = gcrefu(fn->l.uvptr[(ir->op2 >> 8)]);
+      emit_loadu64(as, dest, k);
     } else {
       Reg r = ra_alloc1(as, ir->op1, allow);
       rset_clear(allow, r);
