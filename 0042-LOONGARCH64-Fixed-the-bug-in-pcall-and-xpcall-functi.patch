From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Huang Qiqi <huangqiqi@loongson.cn>
Date: Wed, 27 Nov 2024 15:39:05 +0800
Subject: [PATCH 42/91] LOONGARCH64: Fixed the bug in pcall and xpcall function

---
 src/vm_loongarch64.dasc | 12 +++++-------
 1 file changed, 5 insertions(+), 7 deletions(-)

diff --git a/src/vm_loongarch64.dasc b/src/vm_loongarch64.dasc
index 87026969..f5e246aa 100644
--- a/src/vm_loongarch64.dasc
+++ b/src/vm_loongarch64.dasc
@@ -1328,10 +1328,9 @@ static void build_subroutines(BuildCtx *ctx)
   |.ffunc pcall
   |  ld.d TMP1, L->maxstack
   |  add.d TMP2, BASE, NARGS8:RC
-  |  addi.d NARGS8:RC, NARGS8:RC, -8
   |  .LDXBU TMP3, DISPATCH, DISPATCH_GL(hookmask)
-  |  sltu TMP1, TMP1, TMP2
-  |  bnez TMP1, ->fff_fallback
+  |  bltu TMP1, TMP2, ->fff_fallback
+  |  addi.d NARGS8:RC, NARGS8:RC, -8
   |  or TMP2, BASE, r0
   |  blt NARGS8:RC, r0, ->fff_fallback
   |  addi.d BASE, BASE, 16
@@ -1352,13 +1351,12 @@ static void build_subroutines(BuildCtx *ctx)
   |.ffunc xpcall
   |  ld.d TMP1, L->maxstack
   |  add.d TMP2, BASE, NARGS8:RC
-  |  addi.d NARGS8:TMP0, NARGS8:RC, -16
   |  ld.d CARG1, 0(BASE)
+  |  bltu TMP1, TMP2, ->fff_fallback
+  |  addi.d NARGS8:TMP0, NARGS8:RC, -16
   |  ld.d CARG2, 8(BASE)
-  |  sltu TMP1, TMP1, TMP2
-  |  bnez TMP1, ->fff_fallback
-  |  .LDXBU TMP1, DISPATCH, DISPATCH_GL(hookmask)
   |  blt NARGS8:TMP0, r0, ->fff_fallback
+  |  .LDXBU TMP3, DISPATCH, DISPATCH_GL(hookmask)
   |  gettp TMP2, CARG2
   |  addi.d TMP2, TMP2, -LJ_TFUNC
   |  bnez TMP2, ->fff_fallback		// Traceback must be a function.
