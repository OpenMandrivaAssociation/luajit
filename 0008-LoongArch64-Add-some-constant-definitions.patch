From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Xiaolin Zhao <zhaoxiaolin@loongson.cn>
Date: Wed, 27 Jul 2022 16:21:18 +0800
Subject: [PATCH 08/91] LoongArch64: Add some constant definitions

---
 src/lj_jit.h   | 20 ++++++++++++--------
 src/lj_trace.c | 12 ++++++------
 2 files changed, 18 insertions(+), 14 deletions(-)

diff --git a/src/lj_jit.h b/src/lj_jit.h
index 23cd5066..160f412e 100644
--- a/src/lj_jit.h
+++ b/src/lj_jit.h
@@ -107,6 +107,10 @@ struct riscv_hwprobe {
 
 #endif
 
+//#elif LJ_TARGET_LOONGARCH64
+//#define JIT_F_GS464V            (JIT_F_CPU << 0)
+//#define JIT_F_CPUSTRING         "\6GS464V"
+
 #else
 
 #define JIT_F_CPUSTRING		""
@@ -390,32 +394,32 @@ enum {
 };
 
 enum {
-#if LJ_TARGET_X64 || LJ_TARGET_MIPS64
+#if LJ_TARGET_X64 || LJ_TARGET_MIPS64 || LJ_TARGET_LOONGARCH64
   LJ_K64_M2P64,		/* -2^64 */
 #endif
 #if LJ_TARGET_X86ORX64
   LJ_K64_TOBIT,		/* 2^52 + 2^51 */
   LJ_K64_2P64,		/* 2^64 */
 #endif
-#if LJ_TARGET_MIPS64
+#if LJ_TARGET_MIPS64 || LJ_TARGET_LOONGARCH64
   LJ_K64_2P63,		/* 2^63 */
 #endif
-#if LJ_TARGET_MIPS
+#if LJ_TARGET_MIPS || LJ_TARGET_LOONGARCH64
   LJ_K64_2P31,		/* 2^31 */
 #endif
-#if LJ_TARGET_ARM64 || LJ_TARGET_MIPS64 || LJ_TARGET_RISCV64
+#if LJ_TARGET_ARM64 || LJ_TARGET_MIPS64 || LJ_TARGET_RISCV64 || LJ_TARGET_LOONGARCH64
   LJ_K64_VM_EXIT_HANDLER,
   LJ_K64_VM_EXIT_INTERP,
 #endif
   LJ_K64__MAX,
 };
-#define LJ_K64__USED	(LJ_TARGET_X86ORX64 || LJ_TARGET_ARM64 || LJ_TARGET_MIPS || LJ_TARGET_RISCV64)
+#define LJ_K64__USED	(LJ_TARGET_X86ORX64 || LJ_TARGET_ARM64 || LJ_TARGET_MIPS || LJ_TARGET_RISCV64 || LJ_TARGET_LOONGARCH64)
 
 enum {
-#if LJ_TARGET_X86ORX64 || LJ_TARGET_MIPS64
+#if LJ_TARGET_X86ORX64 || LJ_TARGET_MIPS64 || LJ_TARGET_LOONGARCH64
   LJ_K32_M2P64,		/* -2^64 */
 #endif
-#if LJ_TARGET_MIPS64
+#if LJ_TARGET_MIPS64 || LJ_TARGET_LOONGARCH64
   LJ_K32_2P63,		/* 2^63 */
 #endif
 #if LJ_TARGET_PPC
@@ -431,7 +435,7 @@ enum {
 #endif
   LJ_K32__MAX
 };
-#define LJ_K32__USED	(LJ_TARGET_X86ORX64 || LJ_TARGET_PPC || LJ_TARGET_MIPS)
+#define LJ_K32__USED	(LJ_TARGET_X86ORX64 || LJ_TARGET_PPC || LJ_TARGET_MIPS || LJ_TARGET_LOONGARCH64)
 
 /* Get 16 byte aligned pointer to SIMD constant. */
 #define LJ_KSIMD(J, n) \
diff --git a/src/lj_trace.c b/src/lj_trace.c
index de7fe61e..186d114b 100644
--- a/src/lj_trace.c
+++ b/src/lj_trace.c
@@ -317,24 +317,24 @@ void lj_trace_initstate(global_State *g)
   tv[1].u64 = U64x(80000000,00000000);
 
   /* Initialize 32/64 bit constants. */
-#if LJ_TARGET_X64 || LJ_TARGET_MIPS64
+#if LJ_TARGET_X64 || LJ_TARGET_MIPS64 || LJ_TARGET_LOONGARCH64
   J->k64[LJ_K64_M2P64].u64 = U64x(c3f00000,00000000);
 #endif
 #if LJ_TARGET_X86ORX64
   J->k64[LJ_K64_TOBIT].u64 = U64x(43380000,00000000);
   J->k64[LJ_K64_2P64].u64 = U64x(43f00000,00000000);
 #endif
-#if LJ_TARGET_MIPS64
+#if LJ_TARGET_MIPS64 || LJ_TARGET_LOONGARCH64
   J->k64[LJ_K64_2P63].u64 = U64x(43e00000,00000000);
 #endif
-#if LJ_TARGET_MIPS
+#if LJ_TARGET_MIPS || LJ_TARGET_LOONGARCH64
   J->k64[LJ_K64_2P31].u64 = U64x(41e00000,00000000);
 #endif
 
-#if LJ_TARGET_X86ORX64 || LJ_TARGET_MIPS64
+#if LJ_TARGET_X86ORX64 || LJ_TARGET_MIPS64 || LJ_TARGET_LOONGARCH64
   J->k32[LJ_K32_M2P64] = 0xdf800000;
 #endif
-#if LJ_TARGET_MIPS64
+#if LJ_TARGET_MIPS64 || LJ_TARGET_LOONGARCH64
   J->k32[LJ_K32_2P63] = 0x5f000000;
 #endif
 #if LJ_TARGET_PPC
@@ -349,7 +349,7 @@ void lj_trace_initstate(global_State *g)
   J->k32[LJ_K32_VM_EXIT_HANDLER] = (uintptr_t)(void *)lj_vm_exit_handler;
   J->k32[LJ_K32_VM_EXIT_INTERP] = (uintptr_t)(void *)lj_vm_exit_interp;
 #endif
-#if LJ_TARGET_ARM64 || LJ_TARGET_MIPS64 || LJ_TARGET_RISCV64
+#if LJ_TARGET_ARM64 || LJ_TARGET_MIPS64 || LJ_TARGET_RISCV64 || LJ_TARGET_LOONGARCH64
   J->k64[LJ_K64_VM_EXIT_HANDLER].u64 = (uintptr_t)lj_ptr_sign((void *)lj_vm_exit_handler, 0);
   J->k64[LJ_K64_VM_EXIT_INTERP].u64 = (uintptr_t)lj_ptr_sign((void *)lj_vm_exit_interp, 0);
 #endif
