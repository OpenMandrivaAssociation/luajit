From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Huang Qiqi <huangqiqi@loongson.cn>
Date: Wed, 4 Sep 2024 11:33:56 +0800
Subject: [PATCH 27/91] LOONGARCH64: Add stack check to pcall/xpcall

Change-Id: Iac7ccb0e2c16fb51506d2f60333c82c89ffc0228
---
 src/vm_loongarch64.dasc | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/vm_loongarch64.dasc b/src/vm_loongarch64.dasc
index b9b818d9..a9ee1621 100644
--- a/src/vm_loongarch64.dasc
+++ b/src/vm_loongarch64.dasc
@@ -1326,8 +1326,12 @@ static void build_subroutines(BuildCtx *ctx)
   |//-- Base library: catch errors ----------------------------------------
   |
   |.ffunc pcall
+  |  ld.d TMP1, L->maxstack
+  |  add.d TMP2, BASE, NARGS8:RC
   |  addi.d NARGS8:RC, NARGS8:RC, -8
   |  .LDXBU TMP3, DISPATCH, DISPATCH_GL(hookmask)
+  |  sltu TMP1, TMP1, TMP2
+  |  bnez TMP1, ->fff_fallback
   |  or TMP2, BASE, r0
   |  blt NARGS8:RC, r0, ->fff_fallback
   |  addi.d BASE, BASE, 16
@@ -1346,9 +1350,13 @@ static void build_subroutines(BuildCtx *ctx)
   |  b ->vm_call_dispatch
   |
   |.ffunc xpcall
+  |  ld.d TMP1, L->maxstack
+  |  add.d TMP2, BASE, NARGS8:RC
   |  addi.d NARGS8:TMP0, NARGS8:RC, -16
   |  ld.d CARG1, 0(BASE)
   |  ld.d CARG2, 8(BASE)
+  |  sltu TMP1, TMP1, TMP2
+  |  bnez TMP1, ->fff_fallback
   |  .LDXBU TMP1, DISPATCH, DISPATCH_GL(hookmask)
   |  blt NARGS8:TMP0, r0, ->fff_fallback
   |  gettp TMP2, CARG2
