From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Huang Qiqi <huangqiqi@loongson.cn>
Date: Thu, 22 Jan 2026 21:02:50 +0800
Subject: [PATCH 84/91] LOONGARCH64: Adjust .eh_frame CIE and FDE alignment
 from 8-byte to 4-byte

---
 src/vm_loongarch64.dasc | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/src/vm_loongarch64.dasc b/src/vm_loongarch64.dasc
index 204a5279..47bf95ea 100644
--- a/src/vm_loongarch64.dasc
+++ b/src/vm_loongarch64.dasc
@@ -4451,9 +4451,9 @@ static void emit_asm_debug(BuildCtx *ctx)
 	".LSFDE1:\n"
 	"\t.4byte .LEFDE1-.LASFDE1\n"
 	".LASFDE1:\n"
-	"\t.8byte .Lframe1\n"
+	"\t.4byte .Lframe1\n"
 	"\t.8byte lj_vm_ffi_call\n"
-	"\t.4byte %d\n"
+	"\t.8byte %d\n"
 	"\t.byte 0x81\n\t.uleb128 1\n"		/* offset ra*/
 	"\t.byte 0x96\n\t.uleb128 2\n"		/* offset fp */
 	"\t.byte 0x84\n\t.uleb128 3\n"		/* offset arg1 */
@@ -4477,7 +4477,7 @@ static void emit_asm_debug(BuildCtx *ctx)
 	"\t.4byte lj_err_unwind_dwarf-.\n"
 	"\t.byte 0x1b\n"
 	"\t.byte 0xc\n\t.uleb128 3\n\t.uleb128 0\n"	/* def_cfa sp 0 */
-	"\t.align 3\n"
+	"\t.align 2\n"
 	".LECIE2:\n\n");
     fprintf(ctx->fp,
 	".LSFDE2:\n"
@@ -4495,7 +4495,7 @@ static void emit_asm_debug(BuildCtx *ctx)
     for (i = 31; i >= 24; i--)	/* offset f24-f31 */
       fprintf(ctx->fp, "\t.byte %d\n\t.uleb128 %d\n", 0x80+32+i, 31-i+16);
     fprintf(ctx->fp,
-	"\t.align 3\n"
+	"\t.align 2\n"
 	".LEFDE2:\n\n");
 #if LJ_HASFFI
     fprintf(ctx->fp,
@@ -4511,7 +4511,7 @@ static void emit_asm_debug(BuildCtx *ctx)
 	"\t.uleb128 1\n"			/* augmentation length */
 	"\t.byte 0x1b\n"
 	"\t.byte 0xc\n\t.uleb128 22\n\t.uleb128 0\n"	/* def_cfa fp 0 */
-	"\t.align 3\n"
+	"\t.align 2\n"
 	".LECIE3:\n\n");
     fprintf(ctx->fp,
 	".LSFDE3:\n"
@@ -4524,7 +4524,7 @@ static void emit_asm_debug(BuildCtx *ctx)
 	"\t.byte 0x81\n\t.uleb128 1\n"		/* offset ra*/
 	"\t.byte 0x96\n\t.uleb128 2\n"		/* offset fp */
 	"\t.byte 0x84\n\t.uleb128 3\n"		/* offset arg1 */
-	"\t.align 3\n"
+	"\t.align 2\n"
 	".LEFDE3:\n\n", (int)ctx->codesz - fcofs);
 #endif
 #endif
