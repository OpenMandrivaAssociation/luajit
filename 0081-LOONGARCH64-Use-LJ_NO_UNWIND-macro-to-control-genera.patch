From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Huang Qiqi <huangqiqi@loongson.cn>
Date: Thu, 30 Oct 2025 19:32:14 +0800
Subject: [PATCH 81/91] LOONGARCH64: Use LJ_NO_UNWIND macro to control
 generation of .Lframe1/2 and .LSFDE1/2/3

---
 src/vm_loongarch64.dasc | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/vm_loongarch64.dasc b/src/vm_loongarch64.dasc
index e253a4c1..e23c79f0 100644
--- a/src/vm_loongarch64.dasc
+++ b/src/vm_loongarch64.dasc
@@ -4443,6 +4443,7 @@ static void emit_asm_debug(BuildCtx *ctx)
 	"\t.align 3\n"
 	".LEFDE1:\n\n", (int)ctx->codesz - fcofs);
 #endif
+#if !LJ_NO_UNWIND
     fprintf(ctx->fp, "\t.section .eh_frame,\"a\",@progbits\n");
     fprintf(ctx->fp,
 	".Lframe1:\n"
@@ -4508,6 +4509,7 @@ static void emit_asm_debug(BuildCtx *ctx)
 	"\t.align 2\n"
 	".LEFDE3:\n\n", (int)ctx->codesz - fcofs);
 #endif
+#endif
 #if !LJ_NO_UNWIND
     /* NYI */
 #endif
